% Rocky_5_closed_loop_poles_auto.m
% Automatic pole search to minimize settling time and overshoot

clear;
close all;

syms s a b l g Kp Ki Jp Ji Ci

Hvtheta = -s/l/(s^2-g/l);

K = Kp + Ki/s;

M = a*b/(s+a);

J = Jp + Ji/s + Ci/s^2;

Mfb = M/(1+M*J);

Hcloop = 1/(1-Hvtheta*Mfb*K);

% system parameters
g = 9.81;
l = 0.4873;
a = 23.2135;
b = 0.003;

Hcloop_sub = subs(Hcloop);

best_cost = inf;

% search ranges
sigma_range = 3:0.5:6;      % dominant real part
omega_range = 3:0.5:6;      % oscillation frequency

p3_range = -8:-2:-14;
p4_range = -20:-5:-40;
p5_range = -25:-5:-50;

for sigma = sigma_range
    for omega = omega_range
        for p3 = p3_range
            for p4 = p4_range
                for p5 = p5_range
                    
                    try
                    
                    p1 = -sigma + omega*1i;
                    p2 = -sigma - omega*1i;
                    
                    tgt_char_poly = expand((s-p1)*(s-p2)*(s-p3)*(s-p4)*(s-p5));
                    
                    [n d] = numden(Hcloop_sub);
                    
                    coeffs_denom = coeffs(d,s);
                    coeffs_denom = coeffs_denom/(coeffs_denom(end));
                    
                    coeffs_tgt = coeffs(tgt_char_poly,s);
                    
                    solutions = solve(coeffs_denom(1:5)==coeffs_tgt(1:5),Jp,Ji,Kp,Ki,Ci);
                    
                    Kp_val = double(solutions.Kp);
                    Ki_val = double(solutions.Ki);
                    Ji_val = double(solutions.Ji);
                    Jp_val = double(solutions.Jp);
                    Ci_val = double(solutions.Ci);
                    
                    TFstring = char(subs(Hcloop));
                    
                    s_tf = tf('s');
                    eval(['TFH = ',TFstring]);
                    
                    info = stepinfo(TFH);
                    
                    Ts = info.SettlingTime;
                    Mp = info.Overshoot;
                    
                    cost = Ts + 0.05*Mp;
                    
                    if cost < best_cost && Ts>0
                    
                    best_cost = cost;
                    
                    best_poles = [p1 p2 p3 p4 p5];
                    
                    best_Ts = Ts;
                    best_Mp = Mp;
                    
                    best_gains = [Kp_val Ki_val Ji_val Jp_val Ci_val];
                    
                    best_TF = TFH;
                    
                    end
                    
                    catch
                    
                    end
                
                end
            end
        end
    end
end

disp('Best poles:')
disp(best_poles)

disp('Settling time:')
disp(best_Ts)

disp('Overshoot:')
disp(best_Mp)

disp('Controller gains [Kp Ki Ji Jp Ci]:')
disp(best_gains)

figure
step(best_TF)
title('Best Step Response')

figure
impulse(best_TF)
title('Best Impulse Response')